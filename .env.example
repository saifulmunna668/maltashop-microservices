# Local development values ONLY. Copy to .env (git-ignored) and change them.
# Never commit real secrets (12-Factor "Config", L2 p.59-61; L5 p.136-137).
COMPOSE_PROJECT_NAME=maltashop
IMAGE_TAG=local

POSTGRES_PASSWORD=dev-postgres-admin-change-me
ORDER_DB_PASSWORD=dev-order-db-change-me
PAYMENT_DB_PASSWORD=dev-payment-db-change-me
INVENTORY_DB_PASSWORD=dev-inventory-db-change-me
RABBITMQ_USER=platform
RABBITMQ_PASSWORD=dev-rabbit-change-me

INTERNAL_JWT_SECRET=dev-internal-jwt-secret-change-me-32chars
EXTERNAL_JWT_SECRET=dev-external-jwt-secret-change-me-32chars
PSP_API_KEY=dev-psp-key-change-me
EMAIL_PROVIDER_API_KEY=dev-email-key-change-me
ADMIN_TOKEN=dev-admin-token-change-me
GRAFANA_ADMIN_PASSWORD=dev-grafana-change-me

# Demo customers (password hashes are SHA-256 of alice-demo-pass / bob-demo-pass).
DEMO_USERS=[{"username":"alice","passwordHash":"f83e3d2f6357a2e0d26125f51dce8bc239cd57be96e070a34a8547d1b5511a9c","customerId":"cust-alice","email":"alice@example.com"},{"username":"bob","passwordHash":"21aa80e9cb4d55cb98be43bfdfd5a56ba78700a4f96ef591e5fede3c058707f5","customerId":"cust-bob","email":"bob@example.com"}]
# Partner API keys, stored as SHA-256 hashes (keys: sliema-retail-demo-key / gozo-homeware-demo-key).
PARTNER_KEYS=[{"partnerId":"partner-sliema-retail","keyHash":"4d6cd3c8bcc595642dbac1026739ce4cd90b4a533a2ea18e0d6c5e9fc713bc9f","scopes":["catalog:read","orders:read:partner"]},{"partnerId":"partner-gozo-homeware","keyHash":"699d61d13914c260e2f7e36d091e46ca4194d1e444982a49479a39d79ef5849c","scopes":["catalog:read"]}]

# Fault injection for demonstrations (0 = off).
RECO_FAULT_DELAY_MS=0
RECO_FAULT_ERROR_RATE=0
PSP_FAILURE_RATE=0
EMAIL_FAILURE_RATE=0
