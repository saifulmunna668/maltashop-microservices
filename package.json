{
  "name": "maltashop-prototype",
  "version": "1.0.0",
  "private": true,
  "description": "Repository-level tooling: lint and end-to-end tests. Each service has its own package.json.",
  "scripts": {
    "lint": "eslint .",
    "check:shared": "bash scripts/check-shared.sh",
    "test:unit": "bash scripts/test-all.sh",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "test:scenarios": "node tests/e2e/scenarios.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0"
  }
}
